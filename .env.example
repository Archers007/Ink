# Port for the local server.
PORT=3000

# Cloudflare Tunnel token (for the `cloudflared` service in docker-compose).
# Get it from the Cloudflare Zero Trust dashboard. NEVER commit the real value.
CLOUDFLARED_TOKEN=

# /admin — the issue board. Accounts with these emails become admins the first time they're seen; admins give
# other accounts the moderator or admin role on the page itself.
INK_ADMINS=
# The GitHub repository the board lists and files issues in (owner/name). INK_GITHUB_TOKEN is optional: a
# read-only token lifts the public API's 60 requests/hour limit.
INK_GITHUB_REPO=Archers007/Ink
INK_GITHUB_TOKEN=
# Shared secret between the server and the issue worker that runs on the maintainer's own machine
# (`pnpm issue-worker`): it files each report as a GitHub issue and opens a terminal running Claude on it.
# Any long random string; the same value in both places. The worker also reads INK_URL (default
# http://localhost:8080) to reach the server.
INK_WORKER_TOKEN=
INK_URL=http://localhost:8080

# Sign-in is email + password. Discord / Google are off; INK_OAUTH=1 turns them on (set either pair).
INK_OAUTH=
# Register the redirect URIs with each provider:
#   Discord (discord.com/developers/applications → OAuth2):  <PUBLIC_URL>/auth/discord/callback
#   Google  (console.cloud.google.com → Credentials → OAuth client, Web): <PUBLIC_URL>/auth/google/callback
PUBLIC_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
