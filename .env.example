# Port for the local server.
PORT=3000

# Cloudflare Tunnel token (for the `cloudflared` service in docker-compose).
# Get it from the Cloudflare Zero Trust dashboard. NEVER commit the real value.
CLOUDFLARED_TOKEN=

# Sign-in is email + password. Discord / Google are off; INK_OAUTH=1 turns them on (set either pair).
INK_OAUTH=
# Register the redirect URIs with each provider:
#   Discord (discord.com/developers/applications → OAuth2):  <PUBLIC_URL>/auth/discord/callback
#   Google  (console.cloud.google.com → Credentials → OAuth client, Web): <PUBLIC_URL>/auth/google/callback
PUBLIC_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
